{
  "name": "ideaforge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c black,white \"node --watch server/index.mjs\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "check": "node scripts/check-logic.mjs",
    "test:frontend": "node scripts/frontend-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "playwright": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
